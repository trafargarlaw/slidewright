{
  "name": "@slidewright/cli",
  "version": "0.1.1",
  "description": "Present, build and export Markdown decks from the command line.",
  "keywords": [
    "cli",
    "deck",
    "markdown",
    "pdf",
    "presentation",
    "slides"
  ],
  "homepage": "https://github.com/trafargarlaw/slidewright/tree/master/packages/cli#readme",
  "bugs": "https://github.com/trafargarlaw/slidewright/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trafargarlaw/slidewright.git",
    "directory": "packages/cli"
  },
  "bin": {
    "slidewright": "./bin/slidewright.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@slidewright/vite": "workspace:^",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "playwright-core": "1.58.2",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "playwright-chromium": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-chromium": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
