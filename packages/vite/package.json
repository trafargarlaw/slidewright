{
  "name": "@slidewright/vite",
  "version": "0.1.3",
  "description": "Vite plugin that serves and builds a Markdown deck as a presentation.",
  "keywords": [
    "deck",
    "markdown",
    "presentation",
    "slides",
    "vite-plugin"
  ],
  "homepage": "https://github.com/trafargarlaw/slidewright/tree/master/packages/vite#readme",
  "bugs": "https://github.com/trafargarlaw/slidewright/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trafargarlaw/slidewright.git",
    "directory": "packages/vite"
  },
  "files": [
    "client",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@slidewright/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@slidewright/core": "workspace:^",
    "@slidewright/react": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
