{
  "name": "@slidewright/react",
  "version": "0.0.0",
  "private": true,
  "description": "Render Markdown decks in React. Reacts to Markdown changes as you type.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@slidewright/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@slidewright/source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@slidewright/core": "workspace:*",
    "@types/hast": "^3.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
