{
  "name": "slidewright-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @slidewright/playground dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~7.0.2"
  },
  "packageManager": "bun@1.3.4"
}
